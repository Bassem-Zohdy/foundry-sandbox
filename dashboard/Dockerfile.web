# syntax=docker/dockerfile:1
# Foundry: web image. Build with `docker build -f Dockerfile.web -t web .`
# Builds the app with `npm run build` (vite build, into dist/) and serves dist/ with nginx as an
# unprivileged user on port 8080, with the security headers of nginx.conf.

FROM node:26.13.1-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
# Install scripts are off: a package that needs one runs it explicitly below.
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
# Vite writes every VITE_ variable it reads into the bundle, and copies public/ into dist/ as is.
# Env files never reach the build: BuildKit's Dockerfile.web.dockerignore skips them, but the
# classic builder does not. Build-time values come in as build args (docs/foundry/stacks/react-vite.md).
RUN rm -f .env .env.* && mkdir -p public && find public -name '.env*' -delete && npm run build \
    && find dist -name '*.map' -delete

FROM nginxinc/nginx-unprivileged:1.30.6-alpine AS runtime
# The API's origin for the CSP connect-src; empty when the app calls its own host.
ENV API_ORIGIN=""
# envsubst replaces only these variables in the template, never nginx's own ($uri).
ENV NGINX_ENVSUBST_FILTER="^API_ORIGIN$"
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
# The newest nginx-unprivileged tag of this line still ships Alpine packages (nginx, musl, curl, zlib,
# libexpat ...) with fixed HIGH/CRITICAL CVEs. Upgrade them within the pinned Alpine release; remove
# this once the base tag is current.
USER root
RUN apk upgrade --no-cache
# The base image's nginx user; the files above stay root-owned and read-only to it.
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
